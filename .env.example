# ─── CPU / Windows mode ──────────────────────────────────────────────────────
# For Windows CPU installs, set EMBEDDING_DEVICE=cpu, CROSS_ENCODER_DEVICE=cpu,
# EASYOCR_GPU=false, REMOTE_GPU=False, USE_VLLM=false. CUDA_VISIBLE_DEVICES is
# ignored on CPU. See Windows_README.md for the full CPU setup walkthrough.
EMBEDDING_DEVICE=auto
CROSS_ENCODER_DEVICE=auto
EASYOCR_GPU=false
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=bedrock
SECRET_KEY=thisbetterbesecretkey
API_KEY_1=DUMMY_KEY
API_KEY_2=DUMMY_KEY
API_KEY_3=DUMMY_KEY
API_KEY_4=DUMMY_KEY
API_KEY_5=DUMMY_KEY
API_KEY_6=DUMMY_KEY
TAVILY_API_KEY=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
YOUTUBE_API_KEY=AIzaSyAr_NFOk6OBOBaf6VNvff1mQIcoLJGoHWU
OPENAI_API=DUMMY_KEY

# Patent Search APIs (both optional — pipeline skips gracefully if not set)
PATENTSVIEW_API_KEY=
EPO_CONSUMER_KEY=
EPO_CONSUMER_SECRET=
QUERY_URL=https://llm.katiyar.xyz/query
REMOTE_GPU=False
USE_VISION_MODEL=True
VISION_URL=https://llm.katiyar.xyz/vision-query
MAIN_MODEL=gpt-oss:20b-50k-8k
# Windows CPU users: switch MAIN_MODEL to a 7B-class model (e.g. qwen2.5:7b) —
# 20B at CPU speed is unusably slow on most laptops.
LOCAL_BASE_URL=http://localhost
CUDA_VISIBLE_DEVICES=0   # GPU only; ignored on CPU-only systems

# Model token configuration (tune based on your model)
MODEL_CONTEXT_TOKENS=128000    # Total context window (e.g., 262144 for qwen3.5:9b)
MODEL_OUTPUT_TOKENS=16000      # Max output tokens per LLM call
MODEL_OUTPUT_RESERVE=8000      # Reserved output tokens for budget calculations

# vLLM Configuration (alternative to Ollama — set USE_VLLM=true to enable)
USE_VLLM=false
VLLM_BASE_URL=http://localhost:8010/v1
VLLM_MODEL=google/gemma-4-26B-A4B-it
VLLM_API_KEY=none

# INTERNAL API Configuration
# Set USE_INTERNAL=true to enable INTERNAL API (defaults to false)
INTERNAL_BASE_URL=
INTERNAL_CLIENT_KEY=
INTERNAL_API_TOKEN=
INTERNAL_USER_EMAIL=
INTERNAL_MODEL_ID=
USE_INTERNAL=false